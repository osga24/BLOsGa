---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="找不到這個頁面">
  <p class="meta-kicker">Error 404</p>
  <h1 class="page-title">這裡什麼都沒有。</h1>
  <p class="page-lead">頁面可能被搬走了，或是從來沒存在過。</p>
  <p class="links">
    <a href="/">← 回到首頁</a>
    <a href="/search/">搜尋文章</a>
  </p>
</BaseLayout>

<style>
  .links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    font-size: 0.85rem;
  }
  .links a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .links a:hover {
    color: var(--text);
  }
</style>
