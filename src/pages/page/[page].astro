---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostIndex from "@components/PostIndex.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION } from "@consts";
import { getPosts } from "@utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  // Page 1 lives at "/", so only emit /page/2/ and beyond.
  return paginate(posts, { pageSize: POSTS_PER_PAGE }).filter(
    (p) => p.props.page.currentPage > 1,
  );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title={`Page ${page.currentPage}`} description={SITE_DESCRIPTION}>
  <PostIndex
    posts={page.data}
    current={page.currentPage}
    last={page.lastPage}
    prev={page.currentPage === 2 ? "/" : page.url.prev}
    next={page.url.next}
  />
</BaseLayout>
