---
import BaseLayout from "@layouts/BaseLayout.astro";
import TermIndex from "@components/TermIndex.astro";
import { countBy, getPosts } from "@utils/posts";

const posts = await getPosts();
const tags = countBy(posts.flatMap((p) => p.data.tags));
---

<BaseLayout title="Tags" description="所有標籤與各標籤的文章數量">
  <TermIndex title="Tags" lead={`${tags.length} 個標籤`} base="/tags/" terms={tags} prefix="#" />
</BaseLayout>
