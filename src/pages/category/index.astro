---
import BaseLayout from "@layouts/BaseLayout.astro";
import TermIndex from "@components/TermIndex.astro";
import { countBy, getPosts } from "@utils/posts";

const posts = await getPosts();
const categories = countBy(posts.flatMap((p) => (p.data.category ? [p.data.category] : [])));
---

<BaseLayout title="Category" description="所有分類與各分類的文章數量">
  <TermIndex title="Category" lead={`${categories.length} 個分類`} base="/category/" terms={categories} />
</BaseLayout>
