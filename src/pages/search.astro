---
import BaseLayout from "@layouts/BaseLayout.astro";
import Search from "@components/Search.astro";
---

<BaseLayout title="Search" description="搜尋 BLOsGa 的所有文章">
  <header class="search-head">
    <h1 class="page-title">Search</h1>
    <p class="page-lead">搜尋所有文章的標題與內容，支援中英文關鍵字。</p>
  </header>
  <Search mode="page" />
</BaseLayout>

<style>
  .search-head {
    margin-bottom: 2rem;
  }
</style>
