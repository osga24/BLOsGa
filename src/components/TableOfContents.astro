---
import type { MarkdownHeading } from "astro";

type Props = { headings: MarkdownHeading[] };

const headings = Astro.props.headings.filter((h) => h.depth <= 3);
const minDepth = Math.min(...headings.map((h) => h.depth));
---

{
  headings.length > 1 && (
    <nav class="toc" aria-label="目錄">
      <p class="toc-title">On this page</p>
      <ol class="toc-list">
        {headings.map((h) => (
          <li style={`--indent: ${h.depth - minDepth}`}>
            <a class="toc-link" href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc-title {
    margin: 0 0 0.85rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc-list li {
    padding-left: calc(0.75rem + var(--indent) * 0.75rem);
  }

  .toc-link {
    display: block;
    margin-left: calc(-0.75rem - var(--indent) * 0.75rem - 1px);
    padding: 0.28rem 0 0.28rem calc(0.75rem + var(--indent) * 0.75rem);
    border-left: 1.5px solid transparent;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--muted);
    transition:
      color var(--theme-duration) var(--ease),
      border-color var(--theme-duration) var(--ease);
  }

  .toc-link:hover {
    color: var(--text);
  }

  .toc-link.is-active {
    color: var(--text);
    border-left-color: var(--text);
  }
</style>
