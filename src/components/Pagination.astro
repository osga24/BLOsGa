---
import { Icon } from "astro-icon/components";

type Props = {
  prev?: string;
  next?: string;
  current: number;
  last: number;
};

const { prev, next, current, last } = Astro.props;
---

{
  last > 1 && (
    <nav class="pagination" aria-label="分頁">
      {prev ? (
        <a class="page-link interactive-link" href={prev}>
          <Icon name="lucide:arrow-left" /> Newer
        </a>
      ) : (
        <span />
      )}
      <span class="page-count">
        {current} / {last}
      </span>
      {next ? (
        <a class="page-link interactive-link" href={next}>
          Older <Icon name="lucide:arrow-right" />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 2.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
  }

  .page-link:last-child {
    justify-self: end;
  }

  .page-count {
    color: var(--muted);
  }
</style>
