---
import SiteNav from "@components/SiteNav.astro";
import SocialActions from "@components/SocialActions.astro";
import { SITE_AUTHOR, SITE_INTRO } from "@consts";
---

<aside class="sidebar">
  <div class="sidebar-top">
    <a class="brand" href="/" aria-label="BLOsGa 首頁">
      <span class="wordmark">{SITE_AUTHOR}<span class="wordmark-path">/blog</span></span>
    </a>
    <p class="intro">{SITE_INTRO}</p>
    <div class="actions-wrap">
      <SocialActions />
    </div>
  </div>

  <SiteNav direction="vertical" />

  <div class="sidebar-extra">
    <slot />
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .brand {
    display: inline-flex;
    line-height: 1;
  }

  .wordmark {
    font-weight: 700;
    font-size: 2.4rem;
    letter-spacing: -0.06em;
    color: var(--text);
    white-space: nowrap;
  }

  .wordmark-path {
    color: var(--muted);
    font-weight: 400;
    opacity: 0.6;
    transition: opacity 0.3s var(--ease);
  }

  .brand:hover .wordmark-path {
    opacity: 1;
  }

  .intro {
    margin: 1.25rem 0 0;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--muted);
    white-space: pre-line;
  }

  .actions-wrap {
    margin-top: 1.25rem;
  }

  .sidebar-extra:empty {
    display: none;
  }

  @media (max-width: 959px) {
    .sidebar {
      gap: 0;
    }

    .sidebar-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .wordmark {
      font-size: 2rem;
    }

    .intro {
      display: none;
    }

    .actions-wrap {
      margin-top: 0;
    }

    .sidebar-extra {
      display: none;
    }
  }
</style>
