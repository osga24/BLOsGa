---
import { Image } from "astro:assets";
import AboutCard from "@components/AboutCard.astro";
import { formatDate, getExcerpt, type Post } from "@utils/posts";

type Props = { posts: Post[] };
const { posts } = Astro.props;

// yual.in-style grid: newest post spans two columns, About card sits in the third slot.
const ABOUT_AFTER = 2;
---

<div class="post-grid">
  {
    posts.map((post, i) => (
      <>
        <a class:list={["card", { "is-featured": i === 0 }]} href={`/posts/${post.id}/`}>
          <div class="card-media">
            {post.data.heroImage ? (
              <Image
                src={post.data.heroImage}
                alt=""
                width={i === 0 ? 1200 : 720}
                loading={i < 3 ? "eager" : "lazy"}
                class="card-img"
              />
            ) : (
              <span class="card-placeholder">{post.data.category ?? "Post"}</span>
            )}
          </div>
          <h2 class="card-title">{post.data.title}</h2>
          <p class="card-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.category && <span>· {post.data.category}</span>}
            {post.data.draft && <span class="draft">· draft</span>}
          </p>
          <p class="card-excerpt">{getExcerpt(post)}</p>
        </a>
        {i === ABOUT_AFTER - 1 && <AboutCard />}
      </>
    ))
  }
</div>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3.5rem 2.75rem;
  }

  .card {
    display: block;
  }

  .is-featured {
    grid-column: span 2;
  }

  .card-media {
    position: relative;
    height: 16rem;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-soft);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.35);
    transition: transform 0.5s var(--ease);
  }

  .is-featured .card-media {
    height: 24rem;
  }

  .card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--muted);
  }

  .card-title {
    margin: 1.4rem 0 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.4;
    transition:
      transform 1s var(--ease),
      color var(--theme-duration) var(--ease);
  }

  .is-featured .card-title {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.75;
    transition: transform 0.7s var(--ease);
  }

  .draft {
    color: #b0583f;
  }

  .card-excerpt {
    margin: 0.85rem 0 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-body);
    opacity: 0.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: opacity 0.4s ease;
  }

  @media (hover: hover) {
    .card:hover .card-media {
      transform: scale(1.03);
    }

    .card:hover .card-title {
      transform: translateX(0.5rem);
    }

    .card:hover .card-meta {
      transform: translateX(1rem);
    }

    .card:hover .card-excerpt {
      opacity: 1;
    }
  }

  @media (max-width: 1099px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 719px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
    }

    .is-featured {
      grid-column: auto;
    }

    .card-media,
    .is-featured .card-media {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .card-title {
      margin-top: 1rem;
      font-size: 1.15rem;
    }

    .card-excerpt {
      opacity: 0.75;
      font-size: 0.88rem;
    }
  }
</style>
