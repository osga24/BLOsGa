---
import { Image } from "astro:assets";
import { render } from "astro:content";
import AboutCard from "@components/AboutCard.astro";
import { formatDate, getExcerpt, type Post } from "@utils/posts";

type Props = { posts: Post[] };
const { posts } = Astro.props;

// Newest post spans two columns; the About card takes the slot after the second post.
const ABOUT_AFTER = 2;

const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    minutes: (await render(post)).remarkPluginFrontmatter.minutesRead as number | undefined,
  })),
);
const dotted = (d: Date) => formatDate(d).replaceAll("-", ".");
---

<div class="post-grid">
  {
    items.map(({ post, minutes }, i) => (
      <>
        <a class:list={["card", { "is-featured": i === 0 }]} href={`/posts/${post.id}/`}>
          <div class="card-media">
            {post.data.heroImage ? (
              <Image
                src={post.data.heroImage}
                alt=""
                width={i === 0 ? 1200 : 720}
                loading={i < 3 ? "eager" : "lazy"}
                class="card-img"
              />
            ) : (
              <span class="card-placeholder">{post.data.category ?? "Post"}</span>
            )}
          </div>
          <h2 class="card-title">{post.data.title}</h2>
          <p class="card-meta">
            <time datetime={post.data.pubDate.toISOString()}>{dotted(post.data.pubDate)}</time>
            {post.data.category && <span>· {post.data.category}</span>}
            {minutes && <span>· {minutes} min</span>}
            {post.data.draft && <span class="draft">· draft</span>}
            <span class="card-arrow" aria-hidden="true">→</span>
          </p>
          <p class="card-excerpt">{getExcerpt(post)}</p>
        </a>
        {i === ABOUT_AFTER - 1 && <AboutCard />}
      </>
    ))
  }
</div>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3.25rem 2.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  .is-featured {
    grid-column: span 2;
  }

  .card-media {
    position: relative;
    height: 15rem;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .is-featured .card-media {
    height: 23rem;
  }

  .card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2);
    transition:
      transform 0.8s var(--ease),
      filter 0.5s var(--ease);
  }

  .card-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--muted);
  }

  .card-title {
    margin: 1.15rem 0 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.45;
    transition: color var(--theme-duration) var(--ease);
  }

  .is-featured .card-title {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    letter-spacing: -0.05em;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.45rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .card-arrow {
    margin-left: auto;
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .draft {
    color: #b0583f;
  }

  .card-excerpt {
    margin: 0.75rem 0 0;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (hover: hover) {
    .card:hover .card-img {
      transform: scale(1.03);
      filter: grayscale(0);
    }

    .card:hover .card-title {
      color: var(--accent);
    }

    .card:hover .card-arrow {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (max-width: 1099px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 719px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .is-featured {
      grid-column: auto;
    }

    .card-media,
    .is-featured .card-media {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .card-title {
      font-size: 1.08rem;
    }
  }
</style>
