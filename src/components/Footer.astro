---
import clawdLight from "../assets/clawdLight.gif";
import clawdDark from "../assets/clawdDark.gif";
import { SITE_AUTHOR } from "@consts";

const year = new Date().getFullYear();
const links = [
  { href: "https://osga.dev", label: "osga.dev" },
  { href: "/rss.xml", label: "RSS" },
  { href: "https://github.com/osga24/BLOsGa", label: "Source" },
];
---

<footer class="site-footer">
  <div class="footer-image" aria-hidden="true">
    <img class="footer-gif footer-gif-light" src={clawdLight.src} alt="" width="80" loading="lazy" />
    <img class="footer-gif footer-gif-dark" src={clawdDark.src} alt="" width="80" loading="lazy" />
  </div>
  <hr class="footer-rule" />
  <div class="footer-content">
    <p class="footer-meta text-muted">© {year} {SITE_AUTHOR}</p>
    <nav class="footer-links" aria-label="頁尾連結">
      {links.map((link) => <a class="interactive-link" href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: 6rem;
  }

  .footer-image {
    position: relative;
    display: flex;
    justify-content: flex-end;
    padding-right: 1rem;
    line-height: 0;
    pointer-events: none;
  }

  .footer-gif {
    display: block;
    width: 5rem;
    height: auto;
    transition: opacity var(--theme-duration) var(--ease);
  }

  .footer-gif-dark {
    position: absolute;
    top: -0.35rem;
    right: 1rem;
    opacity: 0;
  }

  :global(:root[data-theme="dark"]) .footer-gif-light {
    opacity: 0;
  }

  :global(:root[data-theme="dark"]) .footer-gif-dark {
    opacity: 1;
  }

  .footer-rule {
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--line);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    font-size: 0.82rem;
  }

  .footer-meta {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.85rem;
  }

  .footer-links a {
    color: var(--muted);
  }
</style>
