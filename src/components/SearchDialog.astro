---
import Search from "@components/Search.astro";
---

<dialog class="search-dialog" data-search-dialog aria-label="搜尋文章">
  <div class="dialog-panel">
    <Search mode="dialog" />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const pageSearch = document.querySelector<HTMLInputElement>('[data-mode="page"] [data-search-input]');

  const open = () => {
    // On /search/ itself, just focus the page's input
    if (pageSearch) {
      pageSearch.focus();
      pageSearch.select();
      return;
    }
    if (!dialog || dialog.open) return;
    dialog.showModal();
    dialog.querySelector<HTMLInputElement>("[data-search-input]")?.focus();
  };

  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    const typing = target.closest("input, textarea, [contenteditable='true']");
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      open();
    } else if (e.key === "/" && !typing) {
      e.preventDefault();
      open();
    }
  });

  // Nav "Search" links open the dialog instead of navigating (still work without JS)
  document.querySelectorAll<HTMLAnchorElement>('a[href="/search/"]').forEach((a) =>
    a.addEventListener("click", (e) => {
      if (pageSearch || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      open();
    }),
  );

  // A search input swallows the first Esc to clear itself; close in one press instead
  dialog?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      e.preventDefault();
      dialog.close();
    }
  });

  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  dialog?.addEventListener("close", () => {
    dialog.querySelector("[data-search]")?.dispatchEvent(new Event("search:reset"));
  });
</script>

<style>
  .search-dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(42rem, calc(100vh - 6rem));
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) + 0.25rem);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.45);
  }

  .search-dialog[open] {
    display: flex;
    animation: dialog-in 0.22s var(--ease);
  }

  .search-dialog::backdrop {
    background: rgba(15, 15, 15, 0.35);
    backdrop-filter: blur(3px);
  }

  .dialog-panel {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.1rem 1.25rem 1rem;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.98);
    }
  }

  @media (max-width: 719px) {
    .search-dialog {
      margin-top: 1rem;
      max-height: calc(100vh - 2rem);
    }
  }
</style>
