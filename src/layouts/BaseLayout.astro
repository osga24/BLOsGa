---
import BaseHead from "@components/BaseHead.astro";
import Sidebar from "@components/Sidebar.astro";
import Footer from "@components/Footer.astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  /** Full-width page without the sidebar (homepage card grid). */
  wide?: boolean;
};

const { wide = false, ...props } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    {
      wide ? (
        <div class="shell-wide">
          <slot name="header" />
          <main class="shell-main">
            <slot />
            <Footer />
          </main>
        </div>
      ) : (
        <div class="shell">
          <div class="shell-side">
            <Sidebar>
              <slot name="sidebar" />
            </Sidebar>
          </div>
          <main class="shell-main">
            <slot />
            <Footer />
          </main>
        </div>
      )
    }
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: 13rem minmax(0, var(--content-width));
    justify-content: center;
    column-gap: clamp(3rem, 7vw, 6rem);
    padding: 12vh 1.5rem 3rem;
  }

  .shell-side {
    position: sticky;
    top: 12vh;
    align-self: start;
    max-height: 82vh;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .shell-side::-webkit-scrollbar {
    display: none;
  }

  .shell-main {
    min-width: 0;
  }

  .shell-wide {
    max-width: 80rem;
    margin: 0 auto;
    padding: 6rem clamp(1.5rem, 5vw, 4rem) 3rem;
  }

  .shell-wide .shell-main {
    margin-top: 4.5rem;
  }

  @media (max-width: 959px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      max-width: calc(var(--content-width) + 2.5rem);
      margin: 0 auto;
      row-gap: 3rem;
      padding: 1.75rem 1.25rem 7rem;
    }

    .shell-side {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  @media (max-width: 959px) {
    .shell-wide {
      padding: 1.75rem 1.25rem 7rem;
    }

    .shell-wide .shell-main {
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 520px) {
    .shell-wide {
      padding: 1.25rem 1rem 7rem;
    }

    .shell {
      padding: 1.25rem 1rem 7rem;
      row-gap: 2.25rem;
    }
  }
</style>
